<mvc:View controllerName="zxx001.orderbad.controller.OrderList"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Page title="{i18n>list.title}">
		<VBox>
			<core:Title text="{i18n>appTitle}"/>
		</VBox>
		<Table id="orderTable" items="{/OrderSet}">
			<columns>
				<Column>
					<Text text="{i18n>appTitle}"/>
				</Column>
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<Input value="{Quantity}" type="Number"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</Page>
</mvc:View>
